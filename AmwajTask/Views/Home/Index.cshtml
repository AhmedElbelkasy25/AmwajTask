@{
    ViewData["Title"] = "Home Page";
}
@model IndexVM

<div class="container" dir="rtl">

    <div class="card mb-4 shadow-sm">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">بيانات الموظف</h4>
        </div>
        <div class="card-body">
            <form asp-action="Create" asp-controller="Employee" method="post">
                <div class="row g-3 align-items-end">
                    <div class="text-danger" asp-validation-summary="ModelOnly"></div>
                    <div class="col-md-2">
                        <label asp-for="NewEmployee.Id" class="form-label fw-bold">رقم الموظف</label>
                        <input asp-for="NewEmployee.Id" class="form-control" placeholder="رقم الموظف" />
                        <span asp-validation-for="NewEmployee.Id" class="text-danger"></span>
                    </div>

                    <div class="col-md-3">
                        <label asp-for="NewEmployee.Name" class="form-label fw-bold">اسم الموظف</label>
                        <input asp-for="NewEmployee.Name" class="form-control" placeholder="اسم الموظف" />
                        <span asp-validation-for="NewEmployee.Name" class="text-danger"></span>
                    </div>

                    <div class="col-md-2">
                        <label asp-for="NewEmployee.BirthDate" class="form-label fw-bold">تاريخ الميلاد</label>
                        <input asp-for="NewEmployee.BirthDate" type="date" value="1990-01-01" class="form-control" />
                        <span asp-validation-for="NewEmployee.BirthDate" class="text-danger"></span>
                    </div>

                    <div class="col-md-2">
                        <label asp-for="NewEmployee.QualificationId" class="form-label fw-bold">المؤهل</label>
                        <select asp-for="NewEmployee.QualificationId" asp-items="@(new SelectList(Model.Qualifications, "Id", "Title"))" class="form-select">
                            <option value="">-- اختر --</option>
                        </select>
                        <span asp-validation-for="NewEmployee.QualificationId" class="text-danger"></span>
                    </div>

                    <div class="col-md-3 text-center">
                        <button type="submit" class="btn btn-success px-4">حفظ</button>
                        
                    </div>

                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-secondary text-white">
            <h5 class="mb-0">قائمة الموظفين</h5>
        </div>
        <div class="card-body p-0">
            <table class="table table-striped table-hover mb-0 text-center">
                <thead class="table-dark">
                    <tr>
                        <th>رقم الموظف</th>
                        <th>اسم الموظف</th>
                        <th>تاريخ الميلاد</th>
                        <th>ادخال اجازات</th>
                        <th></th>
                        <th>مجموع عدد الايام</th>
                        <th>عرض بيانات الموظف</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < Model.Empolyees.Count; i++)
                    {
                        <tr>
                            <td>@Model.Empolyees[i].Id</td>
                            <td>@Model.Empolyees[i].Name</td>
                            <td>@Model.Empolyees[i].BirthDate.ToString("yyyy/MM/dd")</td>
                            <td>
                                <button class="btn btn-info btn-sm" onclick="openVacationModal('@Model.Empolyees[i].Id')">عرض</button>
                            </td>
                            <td>
                                <form asp-action="Delete" asp-controller="Employee" method="post" style="display:inline;">
                                    <input type="hidden" name="id" value="@Model.Empolyees[i].Id" />
                                    <button type="submit" class="btn btn-danger btn-sm" onclick="return confirmDelete(event)">حذف</button>
                                </form>
                                <button type="button" class="btn btn-warning btn-sm" onclick="openEditModal('@Model.Empolyees[i].Id',
                                    '@Model.Empolyees[i].Name', '@Model.Empolyees[i].BirthDate.ToString("yyyy-MM-dd")', '@Model.Empolyees[i].QualificationId')">
                                    تعديل
                                </button>
                            </td>
                            <td><span class="badge bg-primary fs-6">@Model.Empolyees[i].TotalVacationDays</span></td>
                            <td>
                                <a target="_blank" class="btn btn-primary btn-sm" asp-action="Print" asp-controller="Employee" asp-route-id="@Model.Empolyees[i].Id">عرض</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="d-flex justify-content-center mt-3 gap-2">
        <a class="btn btn-outline-primary  @(Model.CurrentPage == 1 ? "disabled" : "")" href="/home?page=@(Model.CurrentPage - 1)">السابق</a>
        <span class="align-self-center fw-bold">صفحة @Model.CurrentPage من @Model.TotalPages</span>
        <a class="btn btn-outline-primary @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")" href="/home?page=@(Model.CurrentPage + 1)">التالي</a>
    </div>

</div>

<div class="modal fade" id="editModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-warning">
                <h5 class="modal-title">تعديل بيانات الموظف</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="Edit" asp-controller="Employee" method="post">
                <div class="modal-body">
                    <input type="hidden" name="Id" id="editId" />
                    <div class="mb-3">
                        <label class="form-label">الاسم</label>
                        <input type="text" name="Name" id="editName" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">تاريخ الميلاد</label>
                        <input type="date" name="BirthDate" id="editBirthDate" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">المؤهل</label>
                        <select name="QualificationId" id="editQualification" class="form-select" required>
                            <option value="">-- اختر --</option>
                            @foreach (var q in Model.Qualifications)
                            {
                                <option value="@q.Id">@q.Title</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                    <button type="submit" class="btn btn-warning">حفظ التعديل</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="vacationModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title">ادارة اجازات الموظف</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="vacationForm">
                    <input type="hidden" id="vacEmpId" />
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label">نوع الاجازة</label>
                            <select id="vacType" class="form-select" required>
                                @foreach (var type in Enum.GetValues<VacationType>())
                                {
                                    <option value="@type">@type</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">تاريخ البداية</label>
                            <input type="date" id="vacStart" class="form-control" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">المدة (يوم)</label>
                            <input type="number" id="vacDuration" class="form-control" min="1" max="30" required />
                        </div>
                    </div>
                    <div class="text-center mt-3">
                        <button type="button" class="btn btn-success" onclick="saveVacation()">اضافة</button>
                    </div>
                </form>
                <hr />
                <table dir="rtl" class="table table-sm text-center">
                    <thead class="table-light">
                        <tr>
                            <th>النوع</th>
                            <th>تاريخ البداية</th>
                            <th>المدة</th>
                            <th>حذف</th>
                        </tr>
                    </thead>
                    <tbody id="vacationList"></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
}
<script>
    function openVacationModal(empId) {
    document.getElementById('vacEmpId').value = empId;
    loadVacations(empId);
    new bootstrap.Modal(document.getElementById('vacationModal')).show();
    }

    async function loadVacations(empId) {
        const res = await fetch(`/Vacation/GetVacations?empId=${empId}`);
        const data = await res.json();
        document.getElementById('vacationList').innerHTML = data.map(v => `
        <tr>
        <td>${v.type}</td>
        <td>${v.startDate}</td>
        <td>${v.duration}</td>
        <td><button class="btn btn-danger btn-sm" onclick="confirmDeleteVacation(${v.id})">حذف</button></td>
        </tr>
        `).join('');
    }

    async function saveVacation() {
        const empId = document.getElementById('vacEmpId').value;

        const body = {
            EmployeeId: empId,
            Type: document.getElementById('vacType').value,
            StartDate: document.getElementById('vacStart').value,
            Duration: parseInt(document.getElementById('vacDuration').value)
        };

        try {
            const response = await fetch('/Vacation/AddVacation', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'Accept': 'application/json'
            },
            body: JSON.stringify(body)
        });

        if (!response.ok) {
            const text = await response.text();
            console.error("Server error:", text);
            Swal.fire({
            icon: 'error',
            title: 'خطأ',
            text: 'خطأ: ' + response.status,
            confirmButtonText: 'حسنا'
            });
            return;
        }

        const result = await response.json();

        if (result.success) {
            loadVacations(empId);
            document.getElementById('vacType').value = '';
            document.getElementById('vacStart').value = '';
            document.getElementById('vacDuration').value = '';
        } else {
            Swal.fire({
            icon: 'error',
            title: 'خطأ',
            text: result.message || 'خطأ غير معروف',
            confirmButtonText: 'حسنا'
            });
        }

        } catch (err) {
        console.error("Fetch error:", err);
        Swal.fire({
            icon: 'error',
            title: 'خطأ في الاتصال',
            text: 'حدث خطأ أثناء الاتصال بالسيرفر',
            confirmButtonText: 'حسنا'
            });
        }
    }

    async function confirmDeleteVacation(id) {
        const result = await Swal.fire({
            title: 'هل أنت متأكد؟',
            text: 'هل تريد حذف هذه الإجازة؟',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#d33',
            cancelButtonColor: '#3085d6',
            confirmButtonText: 'نعم، احذف',
            cancelButtonText: 'إلغاء'
        });

        if (result.isConfirmed) {
            await fetch(`/Vacation/DeleteVacation?id=${id}`, { method: 'POST' });
            loadVacations(document.getElementById('vacEmpId').value);
            // location.reload();
        }
    }

    async function confirmDelete(event) {
        event.preventDefault();
        const form = event.target.closest('form');

    const result = await Swal.fire({
        title: 'هل أنت متأكد؟',
        text: 'هل تريد حذف هذا الموظف وإجازاته؟',
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#d33',
        cancelButtonColor: '#3085d6',
        confirmButtonText: 'نعم، احذف',
        cancelButtonText: 'إلغاء'
        });

        if (result.isConfirmed) {
        form.submit();
        }
    }

    function openEditModal(id, name, birthDate, qualificationId) {
        document.getElementById('editId').value = id;
        document.getElementById('editName').value = name;
        document.getElementById('editBirthDate').value = birthDate;
        document.getElementById('editQualification').value = qualificationId;
        new bootstrap.Modal(document.getElementById('editModal')).show();
    }
</script>